# Copy to .env.local for the CLI (`npm run clip`). Never commit .env.local.
# Keys are only needed for cloud providers (SPEC-110). Local Ollama + whisper.cpp need none.
CLIPPER_ANTHROPIC_KEY=
CLIPPER_OPENAI_KEY=
CLIPPER_GOOGLE_KEY=
CLIPPER_OPENAI_COMPAT_KEY=
CLIPPER_TRANSCRIBE_KEY=
# Optional: where ffmpeg/ffprobe/whisper-cli/yt-dlp live (default: resources/bin/win-x64)
CLIPPER_BIN_DIR=
